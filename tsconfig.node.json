{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noEmitOnError": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": true,
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "outDir": "./tsc-build"
  },
  "include": ["vite.config.ts", "vitest.config.ts", "eslint.config.ts", "build/**/*.ts"]
}
