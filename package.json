{
  "name": "frontend-template",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/SviAnL/frontend-template.git"
  },
  "license": "MIT",
  "author": "SviAnL",
  "type": "module",
  "scripts": {
    "analyze": "vue-tsc --noEmit --incremental && vite build --mode analyze",
    "build": "vue-tsc --noEmit --incremental && vite build --mode production",
    "commit": "cz",
    "dev": "vite",
    "format": "prettier --check --cache --cache-location=.prettiercache . --ignore-unknown",
    "format:fix": "prettier --write . --cache --cache-location=.prettiercache --ignore-unknown",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "prepare": "husky",
    "preview": "vite preview",
    "release": "commit-and-tag-version",
    "start": "powershell -ExecutionPolicy Bypass -File ./start.ps1",
    "style": "stylelint \"src/**/*.{css,vue}\" --cache --allow-empty-input",
    "style:fix": "stylelint \"src/**/*.{css,vue}\" --fix --cache --allow-empty-input",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --build"
  },
  "lint-staged": {
    "*.{js,ts}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix --max-warnings 0",
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.css": [
      "stylelint --fix --allow-empty-input",
      "prettier --write"
    ],
    "*.html": [
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "axios": "^1.18.1",
    "dompurify": "^3.4.12",
    "pinia": "^4.0.2",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.40",
    "vue-i18n": "^11.4.7",
    "vue-router": "^5.2.0",
    "web-vitals": "^6.2.2"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@commitlint/types": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/ri": "^1.2.10",
    "@iconify/vue": "^5.0.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.1",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "4.1.11",
    "@vue/test-utils": "^2.4.11",
    "commit-and-tag-version": "^13.0.0",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "msw": "^2.15.0",
    "postcss-html": "^2.0.0",
    "prettier": "^3.9.5",
    "prettier-plugin-packagejson": "^3.0.2",
    "prettier-plugin-tailwindcss": "0.6.11",
    "rollup-plugin-visualizer": "^7.0.1",
    "sharp": "^0.35.3",
    "stylelint": "^17.14.1",
    "stylelint-config-recommended-vue": "^1.6.1",
    "stylelint-config-standard": "^40.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-icons": "^23.0.1",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.1.5",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-keep-console": "^1.1.1",
    "vite-plugin-mock": "^3.0.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.7"
  },
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": "^22.18.0 || >=24.12.0",
    "pnpm": ">=9.0.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
